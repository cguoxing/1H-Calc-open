/* ── AppBar ── */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #ffffff;
  border: 1rpx solid rgba(16, 37, 68, 0.06);
  border-radius: 24rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 37, 68, 0.02);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  height: 80rpx;
  line-height: 80rpx;
}

.search-input::placeholder {
  color: var(--muted);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(16, 37, 68, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear text {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 700;
}

/* ── 分类 Tab ── */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.category-tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(16, 37, 68, 0.06);
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 500;
  transition: all 0.2s ease;
}

.cat-tab.active {
  background: var(--blue);
  border-color: var(--blue);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(16, 39, 68, 0.15);
}

/* ── 最近使用 ── */
.recent-section {
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.section-action {
  font-size: 24rpx;
  color: var(--muted);
}

.recent-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-list {
  display: inline-flex;
  gap: 16rpx;
}

.recent-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.recent-chip:active {
  opacity: 0.7;
}

.recent-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: none !important;
}

.recent-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
}

/* ── 统计栏 ── */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.stats-text {
  font-size: 24rpx;
  color: var(--muted);
}

.stats-reset {
  font-size: 24rpx;
  color: var(--blue);
  font-weight: 600;
}

/* ── 工具卡片网格 ── */
.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tool-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
}

.tool-card:active {
  opacity: 0.75;
}

.tool-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.tool-card .iconbox {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
}

.tool-card .iconbox image {
  width: 40rpx;
  height: 40rpx;
}

.tool-card .iconbox .text-icon {
  font-size: 36rpx;
  line-height: 1;
}

.tool-card .chev {
  margin-top: 4rpx;
}

.tool-card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.tool-card-desc {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon-box {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

.empty-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--blue);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recent-icon-box {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.recent-text-icon {
  font-size: 24rpx;
  line-height: 1;
}
