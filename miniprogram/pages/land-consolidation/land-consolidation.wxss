/* land-consolidation.wxss — 全域土地综合整治页面样式 */

/* 继承全局样式 */
@import "../../app.wxss";

.h1-subtitle {
  font-size: 20rpx;
  color: #6e7f92;
  margin-top: -12rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* Chip 多选组 */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 0;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 1.5rpx solid rgba(16, 39, 68, 0.12);
  background: #fff;
  font-size: 20rpx;
  color: #6e7f92;
  transition: all 0.2s;
}

.chip.active {
  background: rgba(46, 125, 50, 0.08);
  border-color: #2E7D32;
  color: #2E7D32;
  font-weight: 600;
}

.chip-check {
  width: 28rpx;
  height: 28rpx;
}

.row-stack-title {
  font-size: 20rpx;
  color: #6e7f92;
  padding: 8rpx 0 4rpx;
  font-weight: 600;
}

/* 专项服务列表 */
.special-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.special-item {
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(0,0,0,0.02);
  border: 1rpx solid transparent;
}

.special-item.selected {
  border-color: rgba(46, 125, 50, 0.2);
  background: rgba(46, 125, 50, 0.03);
}

.special-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.special-name {
  font-size: 20rpx;
  color: #1d3046;
  font-weight: 600;
}

.special-params {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.param-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.param-label {
  font-size: 20rpx;
  color: #6e7f92;
  width: 100rpx;
  flex-shrink: 0;
}

.param-input {
  flex: 1;
  height: 56rpx;
  border: 1rpx solid rgba(0,0,0,0.08);
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
  color: #0d1d35;
  background: #fff;
}

.param-unit {
  font-size: 20rpx;
  color: #bcc8d6;
  width: 80rpx;
  flex-shrink: 0;
}

.add-special-btn {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1.5rpx dashed rgba(46, 125, 50, 0.3);
  background: transparent;
  color: #2E7D32;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  line-height: normal;
}

/* 专项服务弹窗 */
.special-service-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  font-size: 20rpx;
  color: #1d3046;
}

.special-service-option:active {
  background: rgba(0,0,0,0.02);
}

.add-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

/* 结果卡片 */
.result-card {
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  margin: 32rpx 0;
  color: #ffffff;
  box-shadow: 0 24rpx 44rpx rgba(46, 125, 50, 0.22), inset 0 2rpx rgba(255,255,255,0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.result-label {
  font-size: 20rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.result-value {
  font-size: 52rpx;
  font-weight: 900;
  margin: 16rpx 0;
  letter-spacing: -1rpx;
}

.result-subtitle {
  font-size: 20rpx;
  opacity: 0.9;
  font-weight: 500;
}

.row-divider {
  height: 1rpx;
  background: rgba(0,0,0,0.06);
  margin: 8rpx 24rpx;
}

/* Toggle switch (复用全局) */
.toggle {
  width: 56rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.1);
  position: relative;
  transition: background 0.2s;
}

.toggle::after {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
  transition: left 0.2s;
}

.toggle.active {
  background: #2E7D32;
}

.toggle.active::after {
  left: 27rpx;
}
