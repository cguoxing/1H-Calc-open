@import "/pages/index/index.wxss";

.container {
  padding: 0 32rpx 80rpx;
}

/* 返回按钮 */
.back-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--icon-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.back-btn image {
  width: 36rpx;
  height: 36rpx;
}

/* 项目概览卡片 */
.project-overview {
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}

.project-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 20rpx;
  margin-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(108,123,143,0.1);
}

.project-name-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.project-name-label {
  font-size: 22rpx;
  color: var(--muted);
}

.project-name-value {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.35;
}

.edit-name-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(16, 39, 68, 0.06);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.overview-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.overview-icon {
  width: 28rpx;
  height: 28rpx;
}

.overview-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.total-label {
  font-size: 22rpx;
  color: var(--muted);
}

.total-value {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ink);
  font-family: "SF Pro Display", -apple-system, "Helvetica Neue", sans-serif;
}

.overview-stats {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--muted);
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(108,123,143,0.1);
}

/* 方案对比入口 */
.compare-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 122, 255, 0.06);
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--accent);
  border: 1rpx solid rgba(0, 122, 255, 0.15);
}

.compare-entry:active {
  background: rgba(0, 122, 255, 0.12);
}

.compare-icon {
  width: 32rpx;
  height: 32rpx;
}

.compare-entry .chev {
  margin-left: auto;
}

.compare-entry .chev image {
  width: 28rpx;
  height: 28rpx;
}

.item-edit {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--blue);
  background: rgba(16, 39, 68, 0.06);
  border-radius: 8rpx;
}

/* 阶段区块 */
.stage-section {
  margin-bottom: 24rpx;
}

.stage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
}

.stage-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stage-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stage-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.stage-count {
  font-size: 22rpx;
  color: var(--muted);
  background: rgba(108,123,143,0.08);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.add-item-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,.6);
  border: 1rpx solid rgba(108,123,143,0.12);
}

.add-item-btn image {
  width: 28rpx;
  height: 28rpx;
}

/* 子项卡片 */
.item-list {
  display: grid;
  gap: 10rpx;
}

.item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  position: relative;
}

.item-card:active {
  background: rgba(255,255,255,0.7);
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-date {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--muted);
}

.item-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.item-amount {
  flex-shrink: 0;
  margin-right: 56rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.item-amount.pending {
  color: var(--accent);
  background: rgba(0, 122, 255, 0.08);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.item-chev image {
  width: 28rpx;
  height: 28rpx;
}

.item-delete {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-delete image {
  width: 36rpx;
  height: 36rpx;
}

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: var(--muted);
  font-size: 22rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.72);
  border: 1rpx solid rgba(108,123,143,0.14);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.danger-zone {
  margin-top: 40rpx;
  border-top: 1rpx solid rgba(108,123,143,0.12);
  padding-top: 30rpx;
  display: flex;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.delete-project-btn {
  color: #ff3b30;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 40rpx;
  border: 1px solid rgba(255, 59, 48, 0.2);
  border-radius: 20rpx;
  background: rgba(255, 59, 48, 0.05);
  text-align: center;
  box-sizing: border-box;
  width: 100%;
}

.delete-project-btn:active {
  background: rgba(255, 59, 48, 0.15);
}
