/* Appbar Simulation */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* Settings Cards */
.settings-card {
  padding: 36rpx 40rpx;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  width: 100%;
}

.card-title {
  margin: 0 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.card-header .card-title {
  margin: 0;
}

/* 状态徽章 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status-badge.online {
  background: rgba(52, 199, 89, 0.1);
  color: #34C759;
}

.status-badge.offline {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
}

.status-badge.online .status-dot {
  background: #34C759;
}

.status-badge.offline .status-dot {
  background: #FF9500;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(108, 123, 143, 0.08);
}

.info-row:last-of-type {
  border-bottom: 0;
}

.info-label {
  font-size: 24rpx;
  color: var(--slate);
}

.info-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 配置引导 */
.env-guide {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255, 149, 0, 0.05);
  border: 1rpx solid rgba(255, 149, 0, 0.15);
  border-radius: 12rpx;
}

.env-guide-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #FF9500;
  margin-bottom: 12rpx;
}

.env-guide-text {
  display: block;
  font-size: 20rpx;
  color: var(--slate);
  line-height: 1.7;
}

/* 用户信息行 */
.user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 24rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.user-info {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.user-info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-info-row:first-child {
  margin-bottom: 8rpx;
}

.user-info-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.user-phone {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.3;
}

/* 详情行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(108, 123, 143, 0.08);
}

.detail-row:last-of-type {
  border-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: var(--muted);
  flex-shrink: 0;
  margin-right: 20rpx;
  min-width: 120rpx;
}

.detail-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.detail-value.mono {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}

/* 设置行 */
.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  min-height: 80rpx;
}

.setting-row + .setting-row {
  border-top: 1rpx solid rgba(108, 123, 143, 0.08);
}

.iconbox {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(108, 123, 143, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.iconbox image {
  width: 28rpx;
  height: 28rpx;
  border: 0 !important;
  border-radius: 0 !important;
}

.row-label {
  flex-grow: 1;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

.setting-row.danger .row-label {
  color: #FF3B30;
}

.setting-row:active {
  opacity: 0.6;
}
