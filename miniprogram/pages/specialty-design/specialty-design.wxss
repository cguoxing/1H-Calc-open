/* =============================================

   专项设计计算器 — Consistent with other pages
   Header bar, tab bar, segmented controls, and
   form layout matching the glassmorphism design system
   ============================================= */

/* Appbar Simulation — matches index/tools/settings/history/result/calc */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* Page title */
.calc-title {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.draft-tip {
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--blue);
  background: rgba(16, 39, 68, 0.06);
  border: 1rpx solid rgba(16, 39, 68, 0.08);
  border-radius: 12rpx;
}

.form-card .row .label {
  flex-shrink: 0;
}

.form-card .row .value {
  flex: 1;
  text-align: right;
  justify-content: flex-end;
  margin-left: 24rpx;
  min-width: 0;
}

.form-card .row-input {
  text-align: right;
}

.form-card .option {
  margin-left: 16rpx;
  text-align: right;
  justify-content: flex-end;
}

.form-card .chev {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.custom-item-name {
  width: 260rpx;
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(108, 123, 143, 0.12);
}

.custom-item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.custom-item-meta .row-input {
  width: 108rpx;
  height: 50rpx;
  font-size: 22rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
}

.add-list-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 72rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  border-top: 1rpx solid var(--line);
}

.add-list-item image {
  width: 28rpx;
  height: 28rpx;
}

.mini-delete {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-delete image {
  width: 28rpx;
  height: 28rpx;
}


/* =============================================
   Tab Bar — S1~S8 pill-style tabs
   Matching the glassmorphism design system
   ============================================= */
.tab-bar {
  flex-direction: row;
  white-space: nowrap;
  padding: 0 4rpx;
}

.tab-bar .tab {
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(102,120,142,.16);
  flex-shrink: 0;
}

.tab-bar .tab.active {
  background: linear-gradient(145deg, #1d3656, #071b34);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 10rpx 20rpx rgba(13,29,53,.18), inset 0 2rpx rgba(255,255,255,.16);
}

/* =============================================
   Segmented Control — matching history page
   ============================================= */
.segmented {
  overflow: hidden;
  border: 1rpx solid rgba(112,128,150,.16);
}

.segmented .seg {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  transition: all 0.2s;
}

.segmented .seg:last-child {
}

.segmented .seg.active {
  margin: -2rpx;
  position: relative;
  z-index: 2;
}
