/* 页面容器 */
.container {
  padding-bottom: 40rpx;
}

.h2-desc {
  font-size: 26rpx;
  color: var(--muted);
  padding: 0 4rpx 24rpx;
}

.policy-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 1rpx solid rgba(16, 39, 68, 0.06);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(47, 62, 82, 0.04);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
}

.search-clear {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  background: rgba(108, 123, 143, 0.1);
  border-radius: 50%;
  flex-shrink: 0;
}

.search-clear text {
  font-size: 30rpx;
  line-height: 1;
}

/* 分类 Tab */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  background: rgba(108, 123, 143, 0.06);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab.active {
  color: #fff;
  background: var(--blue);
}

/* 法规卡片 */
.policy-list {
  display: grid;
  gap: 16rpx;
}

.policy-card {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.policy-card:active {
  opacity: 0.7;
}

.policy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.policy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  flex: 1;
  line-height: 1.4;
}

.policy-header .chev {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.policy-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.policy-docno {
  font-size: 22rpx;
  color: var(--blue);
  font-weight: 600;
  background: rgba(16, 39, 68, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.policy-dept {
  font-size: 22rpx;
  color: var(--muted);
}

.policy-summary {
  font-size: 24rpx;
  color: var(--slate);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--muted);
}
