/* ── AppBar ── */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* ── Divider ── */
.result-divider {
  margin: 32rpx 0;
}

.divider {
  width: 100%;
  height: 1rpx;
  background: var(--line);
  margin: 16rpx 0;
}

/* ── Result Header Card ── */
.result-header-card {
  margin: 12rpx 0;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--ink);
  box-shadow: 0 23rpx 66rpx rgba(0, 0, 0, 0.108);
}

.result-label {
  font-size: 26rpx;
  text-transform: uppercase;
  color: #5f6b7a;
  font-weight: 500;
}

.result-value {
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  margin: 8rpx 0 16rpx;
}

.result-subtitle {
  font-size: 24rpx;
  color: #8b95a5;
  line-height: 1.7;
}

.result-project-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin: 20rpx 0 16rpx;
}

.result-project-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.result-project-label {
  font-size: 22rpx;
  color: var(--muted);
}

.result-project-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
}

.result-project-edit {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(16, 39, 68, 0.06);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

/* ── Formula display ── */
.formula-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.formula-text {
  word-break: break-all;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--slate);
  font-family: monospace;
}

.formula-steps {
  white-space: pre-wrap;
  font-size: 24rpx;
  color: var(--slate);
  line-height: 1.8;
}

/* ── Modal (复用 index 的样式结构) ── */
.modal-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-sheet {
  width: 100%;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.03);
  padding: 32rpx 32rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.35s ease;
  display: flex;
  flex-direction: column;
}

.modal-overlay.open .modal-sheet {
  transform: translateY(0);
}

.modal-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E5E5EA;
  margin: 0 auto 24rpx;
  flex-shrink: 0;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  margin-bottom: 6rpx;
  color: var(--ink);
  flex-shrink: 0;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.save-section-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 18rpx 0 12rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.72);
  border: 1rpx solid rgba(108,123,143,0.14);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.specialty-grid.compact {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.specialty-grid.compact .specialty-chip {
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  justify-content: center;
}

.specialty-grid.compact .specialty-chip-name {
  font-size: 25rpx;
  text-align: center;
}

.specialty-grid.compact .specialty-chip-coef {
  font-size: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  flex-shrink: 0;
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  background: #f1f5f9;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--blue);
}

/* ── Specialty Picker ── */
.specialty-scroll {
  flex: 1;
  overflow-y: auto;
}

.specialty-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding-bottom: 32rpx;
}

.specialty-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e8eef3;
  box-shadow: var(--soft-shadow);
  text-align: left;
}

.specialty-chip.selected {
  background: rgba(16, 39, 68, 0.05);
  border-color: #102744;
  box-shadow: none;
}

.specialty-chip-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--icon-bg);
}

.specialty-chip-icon image {
  width: 28rpx;
  height: 28rpx;
}

.specialty-chip-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.specialty-chip-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.specialty-chip-coef {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.specialty-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.specialty-check image {
  width: 20rpx;
  height: 20rpx;
}

/* ── Empty State ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
}

/* ── Text Utilities ── */
.text-bold {
  font-weight: 800;
}

.text-primary {
  color: var(--blue);
}

.text-small {
  font-size: 20rpx;
}

.text-right {
  text-align: right;
}

/* ── Actions Group 2+1 Layout ── */
.actions-group {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.actions-group .actions {
  display: flex;
  gap: 20rpx;
  margin: 0;
}

.full-width-btn {
  width: 100% !important;
  margin: 0 !important;
}

/* ── Export Status Banner ── */
.export-status-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin: 12rpx 0 24rpx;
  box-sizing: border-box;
}

.export-status-banner.exported {
  background: rgba(34, 197, 94, 0.08);
  color: #16a34a;
  border: 1rpx solid rgba(34, 197, 94, 0.15);
}

.export-status-banner.not-exported {
  background: rgba(249, 115, 22, 0.08);
  color: #ea580c;
  border: 1rpx solid rgba(249, 115, 22, 0.15);
}

.export-status-banner .status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.export-status-banner.exported .status-dot {
  background: #16a34a;
}

.export-status-banner.not-exported .status-dot {
  background: #ea580c;
}

/* ── Source Note ── */
.source-note {
  padding: 0rpx 0 8rpx 0 !important;
  margin-top: -8rpx;
  border-bottom: none !important;
}

.source-text {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 400;
  line-height: 1.4;
}
