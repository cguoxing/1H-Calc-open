  <view class="form-section" wx:if="{{record.calcDetail.interpolationDetail}}">基价内插还原 (直线内插法)</view>
  <view class="glass form-card" wx:if="{{record.calcDetail.interpolationDetail}}" style="padding: 24rpx 32rpx; font-size: 26rpx;">
    <view class="formula-title">计算公式:</view>
    <view class="formula-text">{{record.calcDetail.interpolationDetail.formula}}</view>
    <view class="divider" style="background: var(--line); height: 1rpx; margin: 16rpx 0;"></view>
    <view class="formula-title">内插步骤说明:</view>
    <view class="formula-steps">{{record.calcDetail.interpolationDetail.steps}}</view>
  </view>

  <!-- Action CTA buttons -->
  <view class="actions-group">
    <view class="actions">
      <button class="cta" bindtap="onExportPDF">导出报价单 PDF</button>
      <button class="cta outline" bindtap="onViewProject" wx:if="{{record.projectId}}">查看项目</button>
      <button class="cta" bindtap="onSaveToProject" wx:else>保存到项目</button>
    </view>
    <button class="cta reset full-width-btn" bindtap="onBack">返回修改</button>
  </view>

  <!-- 保存到项目弹窗 -->
  <view class="modal-overlay {{showSaveModal ? 'open' : ''}}" bindtap="closeSaveModal">
      <view class="modal-sheet" catchtap="onPreventDefault">
      <view class="modal-handle"></view>
      <view class="modal-title">保存到项目</view>
      <view class="modal-subtitle">按当前版本首页大类归档</view>

      <view class="save-section-title">归档大类</view>
      <view class="specialty-grid compact">
        <view class="specialty-chip {{item.value === selectedSaveStage ? 'selected' : ''}}"
              wx:for="{{saveStageCategories}}"
              wx:key="value"
              bindtap="onSelectSaveStage"
              data-stage="{{item.value}}">
          <view class="specialty-chip-text">
            <text class="specialty-chip-name">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="modal-actions">
        <view class="soft cancel-btn" bindtap="closeSaveModal">取消</view>
        <view class="soft confirm-btn" bindtap="onConfirmSaveToProject">确认保存</view>
      </view>
    </view>
  </view>

  <!-- 修改项目名称弹窗 -->
  <view class="modal-overlay {{showNameModal ? 'open' : ''}}" bindtap="closeNameModal">
    <view class="modal-sheet" catchtap="onPreventDefault">
      <view class="modal-handle"></view>
      <view class="modal-title">修改项目名称</view>
      <view class="modal-subtitle">用于历史记录、项目列表和计算结果展示</view>
      <view class="form-group">
        <text class="form-label">项目名称 *</text>
        <input class="form-input" placeholder="请输入项目名称" value="{{editingProjectName}}" bindinput="onProjectNameInput"/>
      </view>
      <view class="modal-actions">
        <view class="soft cancel-btn" bindtap="closeNameModal">取消</view>
        <view class="soft confirm-btn" bindtap="onConfirmProjectName">保存</view>
      </view>
    </view>
  </view>

  <view style="height: 50rpx;"></view>

  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
