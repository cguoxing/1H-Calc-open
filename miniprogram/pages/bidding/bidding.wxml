<view class="container">
  <!-- Header -->
  <view class="appbar">
    <view class="brand" bindtap="onGoHome">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text>易计算</text>
    </view>
  </view>

  <!-- 1. 项目基础信息 -->
  <view class="form-section">1. 项目基础信息</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">项目名称</text>
      <input class="row-input" placeholder="输入名称以存入历史" bindinput="onNameInput" value="{{projectName}}" />
    </view>
    
    <picker bindchange="onServiceChange" value="{{serviceIndex}}" range="{{services}}" range-key="label">
      <view class="row big">
        <text class="label">招标类型</text>
        <text class="value">{{services[serviceIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker bindchange="onPolicyChange" value="{{policyIndex}}" range="{{policies}}" range-key="label">
      <view class="row big">
        <text class="label">政策口径</text>
        <text class="value">{{policies[policyIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <view class="row source-note">
      <text></text>
      <text class="source-text">{{policies[policyIndex].desc}}</text>
    </view>
  </view>

  <!-- 2. 项目参数 -->
  <view class="form-section">2. 项目规模</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">中标金额</text>
      <input class="row-input text-right" type="digit" placeholder="输入中标金额" bindinput="onCostInput" value="{{cost}}" />
      <text class="unit">万元</text>
    </view>
  </view>

  <!-- 3. 调整系数 -->
  <view class="form-section">3. 调整系数</view>
  <view class="glass form-card">
    <picker bindchange="onServiceScopeChange" value="{{serviceScopeIndex}}" range="{{serviceScopes}}" range-key="label">
      <view class="row big">
        <text class="label">服务内容</text>
        <text class="value">{{serviceScopes[serviceScopeIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker bindchange="onRatioChange" value="{{ratioIndex}}" range="{{ratios}}" range-key="label">
      <view class="row big">
        <text class="label">收费比例</text>
        <text class="value">{{ratios[ratioIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- 4. 税率 -->
  <view class="form-section">4. 税率</view>
  <view class="glass form-card">
    <picker bindchange="onTaxRateChange" value="{{taxRateIndex}}" range="{{taxRates}}" range-key="label">
      <view class="row big">
        <text class="label">增值税税率</text>
        <text class="value">{{taxRates[taxRateIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- Action CTA buttons -->
  <view class="actions">
    <button class="cta" bindtap="onCalculate">确认</button>
    <button class="cta reset" bindtap="onReset">重置</button>
  </view>

  <!-- Switch link -->
  <view style="padding: 32rpx; text-align: center;">
    <text bindtap="onSwitchToPreConsult" style="font-size: 26rpx; color: var(--ink); text-decoration: underline; opacity: 0.75;">
      ← 返回前期咨询费计算
    </text>
  </view>

  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
