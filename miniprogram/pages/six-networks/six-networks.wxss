/* six-networks.wxss — 六张网工程设计取费页面样式 */
@import "../../app.wxss";

.h1-subtitle {
  font-size: 20rpx;
  color: #6e7f92;
  margin-top: -12rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  line-height: 1.4;
}

.network-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.network-invest {
  font-size: 20rpx;
  color: #102744;
  font-weight: 700;
  padding: 4rpx 12rpx;
  background: rgba(16, 39, 68, 0.06);
  border-radius: 6rpx;
  align-self: flex-start;
}

.network-desc {
  font-size: 20rpx;
  color: #6e7f92;
  line-height: 1.5;
}

.row-sub {
  padding: 4rpx 0 12rpx;
  margin-bottom: 4rpx;
}

.row-sub text {
  font-size: 20rpx;
  color: #bcc8d6;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 0;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 1.5rpx solid rgba(16, 39, 68, 0.12);
  background: #fff;
  font-size: 20rpx;
  color: #6e7f92;
}

.chip.active {
  background: rgba(16, 39, 68, 0.06);
  border-color: #102744;
  color: #102744;
  font-weight: 600;
}

.chip-check {
  width: 28rpx;
  height: 28rpx;
}

.row-stack-title {
  font-size: 20rpx;
  color: #6e7f92;
  padding: 8rpx 0 4rpx;
  font-weight: 600;
}

.result-card {
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  margin: 32rpx 0;
  color: #ffffff;
  box-shadow: 0 24rpx 44rpx rgba(13, 29, 53, 0.22), inset 0 2rpx rgba(255,255,255,0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.result-label {
  font-size: 20rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.result-value {
  font-size: 52rpx;
  font-weight: 900;
  margin: 16rpx 0;
  letter-spacing: -1rpx;
}

.result-subtitle {
  font-size: 20rpx;
  opacity: 0.9;
  font-weight: 500;
  line-height: 1.4;
}

.formula-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #6e7f92;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.formula-text {
  font-family: monospace;
  font-size: 20rpx;
  color: #102744;
  font-weight: 700;
  word-break: break-all;
  line-height: 1.4;
  padding: 10rpx 0;
}

.formula-steps {
  font-size: 20rpx;
  color: #0d1d35;
  white-space: pre-wrap;
  line-height: 1.5;
  margin-top: 10rpx;
}
