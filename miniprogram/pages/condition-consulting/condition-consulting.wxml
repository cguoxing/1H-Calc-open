<view class="container">
  <view class="appbar">
    <view class="brand" bindtap="onGoHome">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text>易计算</text>
    </view>
  </view>
  <view class="h1-subtitle">依据：计价格[2002]125号（环评）+ 2024版广东省导则 + 行业标准</view>

  <!-- 1. 项目信息 -->
  <view class="form-section">1. 项目基础信息</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">项目名称</text>
      <input class="row-input" placeholder="输入名称以存入历史" bindinput="onNameInput" value="{{projectName}}" />
    </view>

    <view class="row big" wx:if="{{typeIndex !== 4 && typeIndex !== 7}}">
      <text class="label">{{typeIndex === 4 ? '取水量' : '项目投资额'}}</text>
      <input class="row-input text-right" type="digit" placeholder="{{typeIndex === 4 ? '万m³/年' : '万元'}}" bindinput="onInvestmentInput" value="{{investment}}" />
      <text class="unit">{{typeIndex === 4 ? '万m³/年' : '万元'}}</text>
    </view>
  </view>

  <!-- 2. 咨询类型 -->
  <view class="form-section">2. 咨询类型选择</view>
  <view class="glass form-card">
    <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{typeOptions}}" range-key="name">
      <view class="row big">
        <text class="label">咨询类型</text>
        <text class="value">{{typeOptions[typeIndex].name}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker wx:if="{{subTypes.length > 0}}" bindchange="onSubTypeChange" value="{{subTypeIndex}}" range="{{subTypes}}" range-key="name">
      <view class="row big">
        <text class="label">子类型</text>
        <text class="value">{{subTypes[subTypeIndex].name}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker bindchange="onRateChange" value="{{rateIndex}}" range="{{rateOptions}}" range-key="name">
      <view class="row big">
        <text class="label">项目复杂度</text>
        <text class="value">{{rateOptions[rateIndex].name}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- 环评特有参数 -->
  <block wx:if="{{typeIndex === 0}}">
    <view class="form-section">3. 环评调整系数</view>
    <view class="glass form-card">
      <picker bindchange="onEnvIndustryChange" value="{{envIndustryIndex}}" range="{{envIndustryOptions}}" range-key="name">
        <view class="row big">
          <text class="label">行业类别</text>
          <text class="value">{{envIndustryOptions[envIndustryIndex].name}}（×{{envIndustryOptions[envIndustryIndex].coef}}）</text>
          <view class="chev"></view>
        </view>
      </picker>
      <picker bindchange="onEnvSensitiveChange" value="{{envSensitiveIndex}}" range="{{envSensitiveOptions}}" range-key="name">
        <view class="row big">
          <text class="label">敏感区类别</text>
          <text class="value">{{envSensitiveOptions[envSensitiveIndex].name}}（×{{envSensitiveOptions[envSensitiveIndex].coef}}）</text>
          <view class="chev"></view>
        </view>
      </picker>
    </view>
  </block>

  <!-- 水资源特有参数 -->
  <block wx:if="{{typeIndex === 4}}">
    <view class="form-section">3. 水资源论证参数</view>
    <view class="glass form-card">
      <view class="row big">
        <text class="label">年取水量</text>
        <input class="row-input text-right" type="digit" placeholder="输入取水量" bindinput="onWaterVolumeInput" value="{{waterVolume}}" />
        <text class="unit">万m³/年</text>
      </view>
      <picker bindchange="onWaterIndustryChange" value="{{waterIndustryIndex}}" range="{{waterIndustryOptions}}" range-key="name">
        <view class="row big">
          <text class="label">行业类别</text>
          <text class="value">{{waterIndustryOptions[waterIndustryIndex].name}}（×{{waterIndustryOptions[waterIndustryIndex].coef}}）</text>
          <view class="chev"></view>
        </view>
      </picker>
    </view>
  </block>

  <!-- 文物特有参数 -->
  <block wx:if="{{typeIndex === 6}}">
    <view class="form-section">3. 文物评估参数</view>
    <view class="glass form-card">
      <view class="row big" wx:if="{{subTypeIndex <= 1}}">
        <text class="label">调查/勘探面积</text>
        <input class="row-input text-right" type="digit" placeholder="输入面积" bindinput="onRelicAreaInput" value="{{relicArea}}" />
        <text class="unit">km²</text>
      </view>
    </view>
  </block>

  <!-- 树木特有参数 -->
  <block wx:if="{{typeIndex === 7}}">
    <view class="form-section">3. 树木保护参数</view>
    <view class="glass form-card">
      <view class="row big">
        <text class="label">树木数量</text>
        <input class="row-input text-right" type="number" placeholder="输入株数" bindinput="onTreeCountInput" value="{{treeCount}}" />
        <text class="unit">株</text>
      </view>
    </view>
  </block>

  <!-- 4. 收费 -->
  <view class="form-section">4. 收费比例与税率</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">总收费比例</text>
      <input class="row-input text-right" type="digit" placeholder="100" bindinput="onDiscountInput" value="{{discount}}" />
      <text class="unit">%</text>
    </view>
    <view class="row big">
      <text class="label">增值税率</text>
      <input class="row-input text-right" type="digit" placeholder="6" bindinput="onTaxRateInput" value="{{taxRate}}" />
      <text class="unit">%</text>
    </view>
  </view>

  <button class="cta" bindtap="onCalculate">开始计算</button>

  <!-- 结果 -->
  <block wx:if="{{resultVisible && result}}">
    <view class="result-card" style="background: linear-gradient(135deg, {{typeOptions[typeIndex].color}}, rgba(0,0,0,0.3));">
      <view class="result-label">{{result.typeName}}费用</view>
      <view class="result-value">¥ {{result.grandTotal}} 万</view>
      <view class="result-subtitle">{{result.subTypeName}} · {{result.formula}}</view>
    </view>

    <view class="form-section">费用明细</view>
    <view class="glass form-card">
      <view class="row big" wx:if="{{result.investment}}">
        <text class="label">项目投资额</text>
        <text class="value">{{result.investment}} 万元</text>
      </view>
      <view class="row big" wx:if="{{result.waterVolume}}">
        <text class="label">年取水量</text>
        <text class="value">{{result.waterVolume}} 万m³/年</text>
      </view>
      <view class="row big" wx:if="{{result.treeCount}}">
        <text class="label">树木数量</text>
        <text class="value">{{result.treeCount}} 株</text>
      </view>
      <view class="row big" wx:if="{{result.baseFee}}">
        <text class="label">基础费用</text>
        <text class="value">{{result.baseFee}} 万元</text>
      </view>
      <view class="row big" wx:if="{{result.totalFee && result.totalFee !== result.baseFee}}">
        <text class="label">调整前费用</text>
        <text class="value">{{result.totalFee}} 万元</text>
      </view>
      <view class="row big" wx:if="{{result.industryCoef}}">
        <text class="label">行业调整系数</text>
        <text class="value">×{{result.industryCoef}}（{{result.industryName}}）</text>
      </view>
      <view class="row big" wx:if="{{result.sensitiveCoef}}">
        <text class="label">敏感区调整系数</text>
        <text class="value">×{{result.sensitiveCoef}}（{{result.sensitiveName}}）</text>
      </view>
      <view class="row big" wx:if="{{result.discount < 100}}">
        <text class="label">总收费比例</text>
        <text class="value">{{result.discount}}%</text>
      </view>
      <view class="row big" wx:if="{{result.taxRate > 0}}">
        <text class="label">增值税率 ({{result.taxRate}}%)</text>
        <text class="value">+{{result.tax}} 万元</text>
      </view>
      <view class="row big" style="background: rgba(13, 29, 53, 0.04);">
        <text style="font-weight: 700;">合计</text>
        <text class="value" style="font-size: 34rpx; font-weight: 800;">{{result.grandTotal}} 万元</text>
      </view>
    </view>
  </block>

  <view style="height: 80rpx;"></view>
  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
