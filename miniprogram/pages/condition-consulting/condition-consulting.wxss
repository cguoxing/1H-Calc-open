/* condition-consulting.wxss */
@import "../../app.wxss";

.h1-subtitle {
  font-size: 20rpx;
  color: #6e7f92;
  margin-top: -12rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  line-height: 1.4;
}

.result-card {
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  margin: 32rpx 0;
  color: #ffffff;
  box-shadow: 0 24rpx 44rpx rgba(13, 29, 53, 0.22), inset 0 2rpx rgba(255,255,255,0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.result-label {
  font-size: 20rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.result-value {
  font-size: 52rpx;
  font-weight: 900;
  margin: 16rpx 0;
  letter-spacing: -1rpx;
}

.result-subtitle {
  font-size: 20rpx;
  opacity: 0.9;
  font-weight: 500;
  line-height: 1.4;
}
