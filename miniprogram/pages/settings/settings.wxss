/* Appbar Simulation */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* Settings Cards */
.settings-card {
  padding: 36rpx 40rpx;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  width: 100%;
}

.card-title {
  margin: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

/* User Row */
.user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.user-info {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.user-info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-info-row:first-child {
  margin-bottom: 8rpx;
}

.user-info-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.user-info-icon.name-icon {
  width: 28rpx;
  height: 28rpx;
}

.user-info-icon.phone-icon {
  width: 28rpx;
  height: 28rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}

.user-phone {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1;
}

.chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.chip-icon-diamond {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border: 0 !important;
  border-radius: 0;
}

.chip-text {
  color: var(--slate);
  font-size: 22rpx;
}


/* Order & Setting Rows */
.order-row, .setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  min-height: 80rpx;
}

.setting-row + .setting-row {
  border-top: 1rpx solid rgba(108, 123, 143, 0.08);
}

.iconbox {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(108, 123, 143, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.iconbox image {
  width: 28rpx;
  height: 28rpx;
}

.setting-row.no-icon {
  padding-left: 0;
}

.row-label {
  flex-grow: 1;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

.setting-row .value {
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
  margin-right: 8rpx;
}

.setting-row:active {
  opacity: 0.6;
}

/* ── Profile Edit Overlay ── */
.profile-edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.profile-edit-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  min-height: 400rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 1001;
  animation: peSlideUp 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

.pe-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 40rpx 24rpx;
  flex-shrink: 0;
}

.pe-scroll {
  flex: 1;
  padding: 0 40rpx;
}

@keyframes peSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.pe-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.pe-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(108, 123, 143, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--muted);
}

/* Avatar section */
.pe-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 0;
}

.pe-avatar-text {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background: var(--blue);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pe-avatar-hint {
  font-size: 22rpx;
  color: var(--muted);
}

/* Form fields */
.pe-field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  background: rgba(108, 123, 143, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(16, 37, 68, 0.04);
}

.pe-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
  margin-right: 24rpx;
  min-width: 140rpx;
  line-height: 1;
}

.pe-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  text-align: right;
  line-height: 96rpx;
  height: 96rpx;
  width: 0;
}

/* Action buttons */
.pe-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 0 40rpx calc(24rpx + 100rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.pe-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  width: 100% !important;
  margin: 0;
}

.pe-cancel {
  background: rgba(108, 123, 143, 0.08);
  color: var(--slate);
}

.pe-save {
  background: var(--blue);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(16, 39, 68, 0.12);
}

/* 社交媒体链接区域样式 */
.social-links-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid rgba(108, 123, 143, 0.08);
  margin-top: 24rpx;
  width: 100%;
}

.social-icons {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
}

.social-item {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: rgba(108, 123, 143, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.social-item:active {
  background: rgba(108, 123, 143, 0.12);
  transform: scale(0.92);
}

.social-icon {
  width: 44rpx;
  height: 44rpx;
  border: 0 !important;
  border-radius: 0 !important;
  display: block;
}

/* 覆盖 iconbox 内 SVG 图标默认的图片投影和边框 */
.iconbox image {
  border: 0 !important;
  border-radius: 0 !important;
}
