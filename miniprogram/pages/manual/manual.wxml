<view class="container">
  <!-- Simulated AppBar -->
  <view class="appbar">
    <view class="brand" bindtap="onGoHome">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text>易计算</text>
    </view>
  </view>

  <view class="standard-list">
    <view class="soft standard-item {{expandedId === item.id ? 'open' : ''}}" wx:for="{{manualData}}" wx:key="id">
      <view class="item-header" bindtap="onToggle" data-id="{{item.id}}">
        <text class="item-title">{{item.title}}</text>
        <view class="chev" style="transform: {{expandedId === item.id ? 'rotate(45deg)' : 'rotate(-45deg)'}}; transition: transform 0.2s ease;"></view>
      </view>
      <view class="item-content" wx:if="{{expandedId === item.id}}">
        <text>{{item.content}}</text>
      </view>
    </view>
  </view>

  <!-- Share Button -->
  <view style="margin-top: 40rpx;">
    <button class="cta" open-type="share">转发使用手册</button>
  </view>

  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
