/* =============================================

   取费计算器 — Consistent with other pages
   Header bar, form inputs, and layout matching
   the glassmorphism design system
   ============================================= */

/* Appbar Simulation — matches index/tools/settings/history/result */
.appbar {
  align-items: center;
  justify-content: space-between;
}

/* Page title */
.calc-title {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.draft-tip {
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--blue);
  background: rgba(16, 39, 68, 0.06);
  border: 1rpx solid rgba(16, 39, 68, 0.08);
  border-radius: 12rpx;
}


/* Margin utilities */

.form-card .row .label {
  flex-shrink: 0;
}

.form-card .row .value {
  flex: 1;
  text-align: right;
  justify-content: flex-end;
  margin-left: 24rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-card .row-input {
  text-align: right;
}

.form-card .option {
  margin-left: 16rpx;
  text-align: right;
  justify-content: flex-end;
}

.form-card .chev {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.coef-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  z-index: 80;
}

.coef-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  max-height: 78vh;
  padding: 28rpx 36rpx calc(28rpx + 100rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -16rpx 40rpx rgba(13, 29, 53, 0.18);
  display: flex;
  flex-direction: column;
}

.coef-sheet-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.coef-sheet-list {
  max-height: calc(78vh - 96rpx - 100rpx - env(safe-area-inset-bottom));
  min-height: 120rpx;
  overflow: hidden;
}

.coef-sheet-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.coef-sheet-close {
  font-size: 24rpx;
  color: var(--muted);
}

.coef-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  border-top: 1rpx solid rgba(108, 123, 143, 0.10);
}

.coef-sheet-label {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coef-sheet-value {
  margin-left: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--blue);
}
