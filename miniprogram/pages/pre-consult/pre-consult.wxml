<view class="container">
  <!-- Header -->
  <view class="appbar">
    <view class="brand" bindtap="onGoHome">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text>易计算</text>
    </view>
  </view>

  <view class="draft-tip">{{draftNotice}}</view>
  <view class="hint" style="margin-top: -8rpx; margin-bottom: 24rpx; padding: 0 8rpx;">依据：计价格[1999]1283号 · 建设项目前期工作咨询收费暂行规定</view>

  <!-- 1. 项目基础信息 -->
  <view class="form-section">1. 项目基础信息</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">项目名称</text>
      <input class="row-input" placeholder="输入名称以存入历史" bindinput="onNameInput" value="{{projectName}}" />
    </view>
    
    <picker bindchange="onServiceChange" value="{{serviceIndex}}" range="{{services}}" range-key="label">
      <view class="row big">
        <text class="label">服务项目</text>
        <text class="value">{{services[serviceIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- 2. 项目参数 -->
  <view class="form-section">2. 项目投资规模</view>
  <view class="glass form-card">
    <view class="row big">
      <text class="label">估算投资总额</text>
      <input class="row-input text-right" type="digit" placeholder="输入估算投资额" bindinput="onCostInput" value="{{cost}}" />
      <text class="unit">万元</text>
    </view>
  </view>

  <!-- 3. 调整系数 -->
  <view class="form-section">3. 调整系数</view>
  <view class="glass form-card">
    <picker bindchange="onIndustryChange" value="{{industryIndex}}" range="{{industries}}" range-key="label">
      <view class="row big">
        <text class="label">行业调整系数</text>
        <text class="value">{{industries[industryIndex].value}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker bindchange="onComplexityChange" value="{{complexityIndex}}" range="{{complexities}}" range-key="label">
      <view class="row big">
        <text class="label">复杂程度系数</text>
        <text class="value">{{complexities[complexityIndex].value}}</text>
        <view class="chev"></view>
      </view>
    </picker>

    <picker bindchange="onRatioChange" value="{{ratioIndex}}" range="{{ratios}}" range-key="label">
      <view class="row big">
        <text class="label">收费比例</text>
        <text class="value">{{ratios[ratioIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- 4. 税率 -->
  <view class="form-section">4. 税率</view>
  <view class="glass form-card">
    <picker bindchange="onTaxRateChange" value="{{taxRateIndex}}" range="{{taxRates}}" range-key="label">
      <view class="row big">
        <text class="label">增值税税率</text>
        <text class="value">{{taxRates[taxRateIndex].label}}</text>
        <view class="chev"></view>
      </view>
    </picker>
  </view>

  <!-- Action CTA buttons -->
  <view class="actions">
    <button class="cta" bindtap="onCalculate">确认</button>
    <button class="cta reset" bindtap="onReset">重置</button>
  </view>

  <!-- Switch link -->
  <view style="padding: 32rpx; text-align: center;">
    <text bindtap="onSwitchToBidding" style="font-size: 26rpx; color: var(--ink); text-decoration: underline; opacity: 0.75;">
      切换至招标代理取费计算 →
    </text>
  </view>

  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
