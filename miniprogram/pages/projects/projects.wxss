/* 复用首页设计语言 */
@import "/pages/index/index.wxss";

.container {
  padding: 0 32rpx 80rpx;
}

.h2-desc {
  font-size: 20rpx;
  color: var(--muted);
  margin: -20rpx 0 32rpx;
  line-height: 1.4;
}

/* 操作按钮组 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

/* 新建项目按钮 */
.create-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--ink);
}

.template-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--blue);
  border: 1rpx solid var(--blue);
  background: rgba(16, 39, 68, 0.04);
}

.plus-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 项目卡片 */
.project-list {
  display: grid;
  gap: 16rpx;
}

.project-card {
  padding: 28rpx 32rpx;
}

.project-card:active {
  background: rgba(255,255,255,0.7);
}

.project-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.project-name {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--ink);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-chev {
  flex-shrink: 0;
}

.project-chev image {
  width: 32rpx;
  height: 32rpx;
}

.project-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 统计条 */
.project-stats {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 16rpx 0 0;
  border-top: 1rpx solid rgba(108,123,143,0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-value.total-val {
  color: #102744;
  font-size: 20rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(108,123,143,0.15);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 20rpx;
  color: var(--muted);
  opacity: 0.6;
}

/* 弹窗表单 */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,.56);
  border: 1rpx solid rgba(108,123,143,0.12);
  padding: 0 24rpx;
  font-size: 20rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,.56);
  border: 1rpx solid rgba(108,123,143,0.12);
  padding: 16rpx 24rpx;
  font-size: 20rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.cancel-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--muted);
}

.confirm-btn {
  flex: 2;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--ink);
}
