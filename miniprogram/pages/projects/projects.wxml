<view class="container">
  <view class="appbar">
    <view class="brand" bindtap="onGoHome">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text>易计算</text>
    </view>
  </view>
  <view class="h2-desc">管理工程取费项目，每个项目可包含多个阶段的计算子项</view>

  <!-- 操作按钮组 -->
  <view class="action-buttons">
    <view class="soft create-btn" bindtap="onCreateProject">
      <image class="plus-icon" src="/images/plus.png"></image>
      <text>新建项目</text>
    </view>
    <view class="soft template-btn" bindtap="onTemplateCreate">
      <image class="plus-icon" src="/images/folder.png"></image>
      <text>从模板创建</text>
    </view>
  </view>

  <!-- 项目列表 -->
  <view class="project-list" wx:if="{{projects.length > 0}}">
    <view class="soft project-card" wx:for="{{projects}}" wx:key="id" bindtap="onViewProject" data-id="{{item.id}}">
      <view class="project-header">
        <view class="project-name">{{item.name}}</view>
        <view class="project-chev">
          <image src="/images/chevron.png"></image>
        </view>
      </view>

      <view class="project-meta" wx:if="{{item.location}}">
        <image class="meta-icon" src="/images/location.png"></image>
        <text>{{item.location}}</text>
      </view>

      <view class="project-stats">
        <view class="stat-item">
          <text class="stat-value">{{item.stageCount}}</text>
          <text class="stat-label">阶段</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{item.itemCount}}</text>
          <text class="stat-label">子项</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item total">
          <text class="stat-value total-val">{{item.totalFee}}万</text>
          <text class="stat-label">合计</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/images/empty.png"></image>
    <text class="empty-title">暂无项目</text>
    <text class="empty-desc">点击上方按钮创建第一个取费项目</text>
  </view>

  <!-- 新建项目弹窗 -->
  <view class="modal-overlay {{showCreateModal ? 'open' : ''}}" bindtap="closeCreateModal">
    <view class="modal-sheet" catchtap="onPreventDefault">
      <view class="modal-handle"></view>
      <view class="modal-title">新建项目</view>
      <view class="modal-subtitle">输入项目基本信息</view>

      <view class="form-group">
        <text class="form-label">项目名称 *</text>
        <input class="form-input" placeholder="例如：XX乡村整村改造运营项目" value="{{formName}}" bindinput="onFormNameInput"/>
      </view>

      <view class="form-group">
        <text class="form-label">项目地点</text>
        <input class="form-input" placeholder="例如：深圳市南山区" value="{{formLocation}}" bindinput="onFormLocationInput"/>
      </view>

      <view class="form-group">
        <text class="form-label">项目描述</text>
        <textarea class="form-textarea" placeholder="简要描述项目范围和目标..." value="{{formDesc}}" bindinput="onFormDescInput"/>
      </view>

      <view class="form-group">
        <text class="form-label">总投资额（万元）</text>
        <input class="form-input" type="digit" placeholder="例如：5000" value="{{formInvestment}}" bindinput="onFormInvestmentInput"/>
      </view>

      <view class="modal-actions">
        <view class="soft cancel-btn" bindtap="closeCreateModal">取消</view>
        <view class="soft confirm-btn" bindtap="onConfirmCreate">创建项目</view>
      </view>
    </view>
  </view>

  <view class="copyright">Copyright © 2026 1+H ARCH</view>
</view>
